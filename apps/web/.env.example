# Firebase Web SDK config (client-side). Copy this file to `.env.local`.
#
# These values are public by design (they ship in the JS bundle); the security
# boundary lives on the backend (firebase-auth.js), which verifies ID tokens
# with the Admin SDK service account and enforces corporate-only emails.
#
# Get the values in Firebase Console -> Project settings -> General ->
# "Your apps" -> Web app -> "Config" (or add a new Web app).

VITE_FIREBASE_PROJECT_ID=shadowtrace-7199f

# REQUIRED - copy from Firebase Console (public, safe to commit).
VITE_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
VITE_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_WEB_APP_ID

# Optional - sensible defaults are derived from the project id when empty.
VITE_FIREBASE_AUTH_DOMAIN=shadowtrace-7199f.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=shadowtrace-7199f.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=421752671625
