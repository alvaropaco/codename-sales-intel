// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String     @id @default(cuid())
  name      String
  cnpj      String?    @unique
  plan      String     @default("trial") // trial | premium
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  users     User[]
  prospects Prospect[]
  activities Activity[]
  workflows Workflow[]
  commercialSettings CommercialSettings?
}

model CommercialSettings {
  id                  String   @id @default(cuid())
  orgId               String   @unique
  organization        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  onboardingCompleted Boolean  @default(false)
  onboardingStep      Int      @default(0)
  companyName         String?
  salesTeamSize       String?
  targetSegments      Json     @default("[]")
  targetCnaes         Json     @default("[]")
  targetLocations     Json     @default("[]")
  companyStatuses     Json     @default("[\"active\"]")
  targetSizes         Json     @default("[]")
  ageRanges           Json     @default("[]")
  averageTicket       Int?
  salesCycle          String?
  valueProposition    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([orgId])
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String?
  phone    String?
  role     String   @default("member")
  orgId    String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Incremented on logout so previously issued session tokens are rejected,
  // even though they are stateless JWTs.
  sessionVersion Int @default(0)
}

model Prospect {
  id                    String   @id @default(cuid())
  cnpj                  String   @unique
  companyName           String
  tradeName             String?
  status                String   @default("prospect") // prospect, qualified, lead
  opportunityScore      Int      @default(0)
  revenueEstimate       Int?
  employees             Int?
  industry              String?
  city                  String?
  state                 String?
  cnpjEmail             String?
  cnpjPhones            Json?
  cnpjPartners          Json?
  cnpjRawData           Json?
  cnpjOpenedAt          DateTime?
  cnpjLegalNature       String?
  enrichmentStatus      String   @default("pending") // pending, enriched, unavailable, error
  enrichmentSource      String?
  enrichmentError       String?
  enrichmentVersion     Int      @default(0)
  enrichmentSummary     Json?
  enrichedAt            DateTime?
  activitiesCount       Int      @default(0)
  lastContact           DateTime?                     // timestamp do 1º envio real (email/whatsapp)
  contactedChannels     Json     @default("[]")       // ["email","whatsapp"] — badge "Contatado"
  qualificationStage    String   @default("initial_contact")
  creditRiskScore       Int?
  creditRiskLevel       String?
  orgId                 String
  organization          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  activities            Activity[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([orgId])
  @@index([status])
  @@index([createdAt])
  @@index([enrichedAt])
  @@index([enrichmentStatus])
}

model Activity {
  id         String   @id @default(cuid())
  type       String   // call, email, meeting, note
  description String?
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  orgId      String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@index([prospectId])
  @@index([orgId])
}

model Workflow {
  id          String   @id @default(cuid())
  name        String
  trigger     String   // prospect_created, score_changed, etc
  action      String   // send_email, create_task, etc
  status      String   @default("active")
  orgId       String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([orgId])
}

// Resultados do pipeline de enriquecimento via NATS (enrichment.company.completed.v1).
// A chave única (companyId, enrichmentVersion) torna a persistência idempotente,
// garantindo que a mesma mensagem at-least-once não duplique dados.
model CnpjEnrichment {
  id               String    @id @default(cuid())
  companyId        String                       // prospect.id enviado como company_id
  cnpj             String
  enrichmentVersion Int     @default(1)
  requestEventId   String?
  status           String    @default("COMPLETED") // COMPLETED, PARTIAL, FAILED, DISCARDED
  errorCode        String?
  errorMessage     String?
  companyName      String?
  tradeName        String?
  industry         String?
  revenueEstimate  Int?
  employees        Int?
  cnpjEmail        String?
  cnpjPhones       Json?
  cnpjPartners     Json?
  cnpjOpenedAt     DateTime?
  cnpjLegalNature  String?
  score            Int?
  rawPayload       Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([companyId, enrichmentVersion])
  @@index([cnpj])
  @@index([status])
}

// ============================================================================
// COLD SALES AUTOMATICO — Outreach via Gmail
// ============================================================================

// Conta de email conectada ao cliente para envio de outreach.
// provider: "gmail" (OAuth API), "smtp" (ex.: Gmail com App Password), "resend" (API HTTP).
model EmailAccount {
  id                      String   @id @default(cuid())
  tenantId                String                         // organization.id
  userId                  String                         // user.id (dono da conta)
  provider                String    @default("gmail")     // gmail, smtp, resend
  email                   String                         // endereço de envio (From)
  encryptedRefreshToken   String?                         // gmail: refresh token OAuth
  encryptedSecret         String?                         // smtp: password/app password · resend: api key
  smtpHost                String?                         // smtp: ex.: smtp.gmail.com
  smtpPort                Int?                           // smtp: ex.: 587 (STARTTLS) ou 465 (TLS)
  smtpSecure              Boolean   @default(false)      // smtp: true quando porta 465
  fromName                String?                         // nome amigável do remetente (opcional)
  scopes                  Json      @default("[]")        // ["gmail.send", "gmail.metadata"] (provider gmail)
  status                  String    @default("connected") // connected, revoked, expired, error
  lastHistoryId           String?                         // token da última consulta do history (provider gmail)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  contacts                OutreachContact[]

  @@index([tenantId])
  @@index([userId])
  @@index([email])
}

// Campanha de outreach (agrupa contactos).
model OutreachCampaign {
  id          String   @id @default(cuid())
  tenantId    String                         // organization.id
  name        String
  description String?
  status      String   @default("draft")     // draft, active, paused, completed

  // ── Suíte multicanal (gatilho pós-enriquecimento) ──────────────────
  // trigger=on_enrichment + autoActive: assim que o enriquecimento do lead
  // conclui, dispara os canais selecionados com os templates configurados.
  trigger                String   @default("manual")  // manual | on_enrichment
  channels               Json     @default("[]")      // ["email", "whatsapp"]
  autoActive             Boolean  @default(false)     // automação ligada?
  emailAccountId         String?                      // conta de envio do disparo automático
  emailTemplateSubject   String?                      // placeholders {{companyName}}, {{firstName}}, {{city}}, {{industry}}
  emailTemplateBody      String?                      // texto plano (email single-shot quando template custom)
  whatsappAccountId      String?                      // conta WAHA do disparo automático
  whatsappTemplate       String?                      // mensagem WhatsApp (mesmos placeholders)
  autoWhatsAppCampaignId String?                      // WhatsAppCampaign criada p/ automação (reusada)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contacts    OutreachContact[]

  @@index([tenantId])
  @@index([status])
}

// Relação entre um lead/prospect e uma campanha de outreach.
model OutreachContact {
  id                String   @id @default(cuid())
  campaignId        String
  campaign          OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospectId        String                         // prospect.id
  emailAccount_id       String?
  emailAccount          EmailAccount? @relation(fields: [emailAccount_id], references: [id])
  status                String   @default("SELECTED") // SELECTED → QUEUED → GENERATING → SCHEDULED → SENDING → SENT → DELIVERED_INFERRED → OPENED_INFERRED → REPLIED
  // States parallel: BOUNCED, FAILED, UNSUBSCRIBED, CANCELLED
  outreachSequence  Int      @default(1)           // 1=primeiro email, 2=follow-up, ...
  scheduledAt       DateTime?                      // quando deve ser enviado
  sentAt            DateTime?
  nextFollowupAt    DateTime?
  lastReplyAt       DateTime?                      // ultima resposta do lead
  replyCount        Int      @default(0)
  unsubscribed      Boolean  @default(false)
  cancelReason      String?                        // replied, unsubscribed, bounced, cancelled
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  messages          OutreachMessage[]
  events            OutreachEvent[]

  @@unique([prospectId, campaignId])
  @@index([campaignId])
  @@index([prospectId])
  @@index([status])
}

// Modelo de mensagem reutilizavel dentro de campanhas.
model OutreachTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  subject     String
  body        String    // texto base (sem tracking pixel)
  htmlBody    String?   // versão HTML com placeholder do pixel
  status      String   @default("draft")  // draft, active
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    OutreachMessage[]

  @@index([tenantId])
}

// Mensagem individual gerada/encaminhada para um contacto.
model OutreachMessage {
  id                String   @id @default(cuid())
  contactId         String
  contact           OutreachContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  templateId        String?
  template          OutreachTemplate? @relation(fields: [templateId], references: [id])
  subject           String
  body              String    // texto plain
  htmlBody          String?   // HTML com pixel de tracking
  gmailMessageId    String?   // id retornado pela Gmail API
  gmailThreadId     String?
  messageHeaderId   String?   // Message-ID header
  status            String   @default("GENERATING") // GENERATING → SCHEDULED → SENDING → SENT
  error             String?
  generatedAt       DateTime?
  scheduledFor      DateTime?
  sentAt            DateTime?
  trackingToken     String?   // uuid para pixel
  aiReasoningFacts  Json?    // fatos usados pela IA
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  events            OutreachEvent[]

  @@index([contactId])
  @@index([status])
  @@index([trackingToken])
  @@index([gmailMessageId])
}

// Eventos que constroem a timeline do lead.
model OutreachEvent {
  id           String   @id @default(cuid())
  contactId    String?
  contact      OutreachContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messageId    String?
  message      OutreachMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type         String   // email_scheduled, email_sent, email_delivered_inferred, email_opened_inferred, email_replied, email_bounced, email_failed, email_unsubscribed, email_cancelled, followup_scheduled, followup_sent
  status       String
  details      Json?    // dados adicionais (gmail ids, timestamp, etc)
  createdAt    DateTime @default(now())

  @@index([contactId])
  @@index([messageId])
  @@index([type])
  @@index([createdAt])
}

// Lista de emails/endereços para não enviar (unsubscribe + suppression).
model SuppressionList {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  reason    String?  // unsubscribed, bounce, manual
  addedAt   DateTime @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ============================================================================
// WHATSAPP — Prospecção E2E via WAHA (WhatsApp HTTP API)
// ============================================================================

// Conta WhatsApp conectada ao workspace através do WAHA.
// Não armazena credenciais: a API key do WAHA vive apenas no ambiente do servidor.
model WhatsAppAccount {
  id          String   @id @default(cuid())
  orgId       String                         // organization.id
  userId      String                         // user.id (dono da conta)
  provider    String   @default("waha")      // waha
  sessionName String   @unique               // nome determinístico da sessão WAHA
  phoneNumber String?
  status      String   @default("CREATED")   // CREATED, STARTING, QR_REQUIRED, CONNECTED, DISCONNECTED, STOPPED, ERROR
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns     WhatsAppCampaign[]
  conversations WhatsAppConversation[]

  @@index([orgId])
  @@index([userId])
}

// Campanha de prospecção via WhatsApp (agrupa leads e sequência de etapas).
model WhatsAppCampaign {
  id                String   @id @default(cuid())
  orgId             String                         // organization.id
  name              String
  whatsappAccountId String?
  whatsappAccount   WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  status            String   @default("DRAFT")     // DRAFT, SCHEDULED, RUNNING, PAUSED, COMPLETED, CANCELLED
  startedAt         DateTime?
  pausedAt          DateTime?
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  steps    WhatsAppSequenceStep[]
  contacts WhatsAppCampaignContact[]

  @@index([orgId])
  @@index([status])
}

// Etapa da sequência de mensagens de uma campanha (mensagem + delay + condições).
model WhatsAppSequenceStep {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  orderIndex      Int      @default(0)
  messageTemplate String
  delayMinutes    Int      @default(0)             // delay em minutos antes deste step
  conditions      Json     @default("[]")          // condições opcionais (ex.: só enviar se lead abriu)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([campaignId, orderIndex])
  @@index([campaignId])
}

// Relação lead ↔ campanha: âncora de idempotência e progresso da sequência.
model WhatsAppCampaignContact {
  id               String   @id @default(cuid())
  campaignId       String
  campaign         WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospectId       String
  phoneNumber      String?
  status           String   @default("QUEUED")     // QUEUED → SENDING → SENT → REPLIED | CANCELLED, OPTED_OUT
  currentStepIndex Int      @default(0)
  lastSentAt       DateTime?
  nextSendAt       DateTime?
  cancelReason     String?                          // replied, opted_out, do_not_contact, cancelled
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([campaignId, prospectId])
  @@index([prospectId])
  @@index([status])
}

// Conversa 1:1 com um lead via WhatsApp (inbox).
model WhatsAppConversation {
  id                   String   @id @default(cuid())
  orgId                String
  whatsappAccountId    String?
  whatsappAccount      WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  prospectId           String?
  phoneNumber          String
  status               String   @default("ACTIVE") // ACTIVE, PAUSED, HUMAN_HANDOFF, CLOSED, OPTED_OUT
  lastMessageAt        DateTime?
  lastInboundMessageAt DateTime?
  assignedTo           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  messages WhatsAppMessage[]

  @@unique([orgId, phoneNumber])
  @@index([orgId])
  @@index([prospectId])
  @@index([status])
}

// Mensagem individual (enviada ou recebida). providerMessageId é único por
// conversa → dedup de eventos at-least-once do webhook.
model WhatsAppMessage {
  id                String   @id @default(cuid())
  conversationId    String
  conversation      WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  orgId             String
  campaignContactId String?
  direction         String                           // INBOUND, OUTBOUND
  type              String   @default("TEXT")        // TEXT, IMAGE, DOCUMENT, AUDIO, VIDEO, LOCATION
  content           String?
  mediaUrl          String?
  providerMessageId String?
  status            String   @default("PENDING")     // PENDING, SENT, DELIVERED, READ, FAILED
  stepIndex         Int?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([conversationId, providerMessageId])
  @@unique([campaignContactId, stepIndex])
  @@index([conversationId])
  @@index([direction])
  @@index([status])
}

// Estado de engajamento do lead POR CANAL (whatsapp, email, linkedin, ...).
// Permite opt-out / do-not-contact do WhatsApp sem afetar os demais canais e
// sem duplicar o cadastro do lead (que permanece no modelo Prospect).
model LeadChannelState {
  id          String   @id @default(cuid())
  orgId       String
  prospectId  String
  channel     String   @default("whatsapp")          // whatsapp, email, linkedin
  status      String   @default("active")            // active, opted_out, do_not_contact
  phoneNumber String?
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([prospectId, channel])
  @@index([orgId])
  @@index([channel])
  @@index([status])
}
