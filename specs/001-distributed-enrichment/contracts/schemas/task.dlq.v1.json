{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "enrichment.task.dlq.v1",
  "title": "Poison message (DLQ) de task",
  "type": "object",
  "required": ["version", "taskId", "jobId", "orgId", "capability", "reason", "attempts"],
  "properties": {
    "version": { "const": "1" },
    "taskId": { "type": "string" },
    "jobId": { "type": "string" },
    "orgId": { "type": "string" },
    "capability": { "type": "string" },
    "reason": { "enum": ["MAX_DELIVER_EXHAUSTED", "POISON_MESSAGE"] },
    "lastError": {
      "type": "object",
      "properties": { "type": { "type": "string" }, "message": { "type": "string" } }
    },
    "attempts": { "type": "integer" }
  }
}
