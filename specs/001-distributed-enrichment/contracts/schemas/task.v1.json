{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "enrichment.task.v1",
  "title": "Task de enriquecimento (despacho)",
  "type": "object",
  "required": ["version", "taskId", "taskKey", "jobId", "orgId", "prospectId", "entityKey", "entityType", "capability", "input", "priority", "attempt", "maxAttempts", "timeoutMs", "depth", "createdAt"],
  "properties": {
    "version": { "const": "1" },
    "taskId": { "type": "string" },
    "taskKey": { "type": "string" },
    "jobId": { "type": "string" },
    "orgId": { "type": "string" },
    "prospectId": { "type": "string" },
    "entityKey": { "type": "string" },
    "entityType": { "type": "string", "enum": ["prospect", "company", "person", "domain", "email", "phone", "social_profile", "product", "article"] },
    "capability": { "type": "string" },
    "provider": { "type": ["string", "null"] },
    "input": { "type": "object" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 3 },
    "attempt": { "type": "integer", "minimum": 1 },
    "maxAttempts": { "type": "integer", "minimum": 1 },
    "timeoutMs": { "type": "integer", "minimum": 1000 },
    "depth": { "type": "integer", "minimum": 0 },
    "spawnedByTaskId": { "type": ["string", "null"] },
    "notBefore": { "type": ["string", "null"], "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "traceparent": { "type": "string" }
  },
  "additionalProperties": false
}
