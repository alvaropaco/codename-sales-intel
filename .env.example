# b2base-platform — variáveis de ambiente (exemplo, sem segredos reais)
# Copie para .env e preencha. NUNCA commite o .env real (constituição V).

# ── Banco (Prisma) ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/b2base"

# ── Gateway LLM (LiteLLM, API OpenAI-compatível) ────────────────────────────
# Usado por llm-client.js (campanhas, extração Ava, análise profunda 005).
LITELLM_URL="http://localhost:4000"
LITELLM_MODEL="qwen/qwen2.5-7b-instruct"
# LITELLM_API_KEY="..."

# ── Análise profunda de lead (feature 005, premium) ─────────────────────────
# Modelo/alias específico da análise; cai no LITELLM_MODEL se ausente/falhar.
# DEEP_ANALYSIS_LLM_MODEL=""
# Reconciliação no boot: re-despacha análises presas em 'running' (padrão
# resumePendingEnrichments). Desabilite com "false"; limite por varredura.
# DEEP_ANALYSIS_RECONCILE_ON_BOOT="true"
# DEEP_ANALYSIS_RECONCILE_LIMIT="100"

# ── Discovery Engine (specs/006-discovery-engine) ───────────────────────────
# Providers self-hosted/free (sem chave, sempre ativos): searxng, crtsh,
# dns-rdap, http-metadata. CNPJ MCP usa as vars abaixo (já existentes).
# CNPJ_MCP_URL="https://mcps.0xcloud.net/mcp"
# CNPJ_MCP_TOKEN=""
# SEARXNG_URL="https://search.0xcloud.net"
# Enumeração passiva de subdomínios (Chaos/ProjectDiscovery — opcional)
# PROJECTDISCOVERY_API_KEY=""
# Providers pagos — budget-gated; ausentes → run "skipped" com fallback (T040)
# SERPER_API_KEY=""
# BRAVE_API_KEY=""
# EXA_API_KEY=""
# Jurídicos (opcionais, budget-gated)
# JUSBRASIL_TOKEN=""
# ESCAVADOR_TOKEN=""
# Financeiros (opcionais; mirror CVM + agregador de funding)
# CVM_BASE_URL=""
# FUNDING_BASE_URL=""
# FUNDING_API_KEY=""
# SpiderFoot: APENAS adapter de compatibilidade, fora do caminho crítico
# SPIDERFOOT_URL=""
# SPIDERFOOT_API_KEY=""
# SPIDERFOOT_TIMEOUT_MS="60000"
