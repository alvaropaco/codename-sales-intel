DATABASE_URL="postgresql://cnpj:cnpj@localhost:5432/cnpj?schema=public"
NODE_ENV="development"
PORT=3001

# NATS enrichment pipeline
NATS_URL="nats://legal-nats.laweragent.svc.cluster.local:4222"
NATS_ENABLED="false"
NATS_STREAM="ENRICHMENT"
NATS_DURABLE="salesintel-results"
NATS_REQUEST_SUBJECT="enrichment.company.requested.v1"
NATS_COMPLETED_SUBJECT="enrichment.company.completed.v1"
NATS_DLQ_SUBJECT="enrichment.company.dlq.v1"
NATS_BATCH=20
NATS_FETCH_TIMEOUT_MS=5000
