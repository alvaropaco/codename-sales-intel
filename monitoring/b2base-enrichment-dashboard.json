{
  "title": "B2Base — Motor de Enriquecimento Distribuído",
  "uid": "b2base-enrichment-v2",
  "tags": ["b2base", "enrichment"],
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Tasks por capability e estado",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "b2base_enrichment_tasks", "legendFormat": "{{capability}} {{state}}" }]
    },
    {
      "id": 2,
      "title": "Pendência por capability (base autoscaling)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "b2base_enrichment_tasks_pending", "legendFormat": "{{capability}}" }]
    },
    {
      "id": 3,
      "title": "Duração p95 por capability",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(b2base_enrichment_task_duration_seconds_bucket[5m])) by (capability, le))", "legendFormat": "{{capability}} p95" }]
    },
    {
      "id": 4,
      "title": "Providers — chamadas por resultado",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "sum(rate(b2base_enrichment_provider_requests_total[5m])) by (provider, outcome)", "legendFormat": "{{provider}} {{outcome}}" }]
    },
    {
      "id": 5,
      "title": "Providers — estado do circuit breaker",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "expr": "b2base_enrichment_provider_state", "legendFormat": "{{provider}} {{state}}" }]
    },
    {
      "id": 6,
      "title": "Qualificação — recálculos e falhas",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "rate(b2base_enrichment_qualification_total[5m])", "legendFormat": "recalcs/s" },
        { "expr": "rate(b2base_enrichment_qualification_failures_total[5m])", "legendFormat": "failures/s" }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
