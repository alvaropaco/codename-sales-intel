{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cnpj-data-publisher.dev/company-br-cnpj-reactivated-v1.schema.json",
  "title": "COMPANY_REACTIVATED v1",
  "description": "A company that was not active in the previous snapshot and is active now.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_version": {
      "type": "integer",
      "const": 1
    },
    "source": {
      "type": "string",
      "const": "cnpj-data-publisher"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "event_type": {
      "type": "string",
      "const": "COMPANY_REACTIVATED"
    },
    "subject": {
      "type": "string",
      "pattern": "\\.reactivated\\.v1$",
      "description": "Subject ending in .reactivated.v1. The prefix is set by NATS_SUBJECT_PREFIX."
    },
    "data": {
      "type": "object",
      "properties": {
        "cnpj": {
          "type": "string",
          "minLength": 14,
          "maxLength": 14
        },
        "previous_registration_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_registration_status_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_registration_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_registration_status_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "company": {
          "type": "object",
          "properties": {
            "cnpj": {
              "type": "string",
              "minLength": 14,
              "maxLength": 14,
              "description": "Always textual. Never parse as an integer."
            },
            "cnpj_basic": {
              "type": "string",
              "minLength": 8,
              "maxLength": 8
            },
            "cnpj_order": {
              "type": "string",
              "minLength": 4,
              "maxLength": 4
            },
            "cnpj_check_digits": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            },
            "headquarters_branch": {
              "enum": [
                "HEADQUARTERS",
                "BRANCH",
                "UNKNOWN"
              ]
            },
            "legal_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "trade_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "registration_status": {
              "enum": [
                "NULL",
                "ACTIVE",
                "SUSPENDED",
                "UNFIT",
                "CLOSED",
                "UNKNOWN"
              ]
            },
            "registration_status_code": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{2}$"
            },
            "registration_status_date": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "registration_status_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "opening_date": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "legal_nature": {
              "type": "object",
              "properties": {
                "code": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "code"
              ]
            },
            "main_cnae": {
              "type": "object",
              "properties": {
                "code": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "code"
              ]
            },
            "secondary_cnaes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9]{7}$"
              }
            },
            "company_size_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "share_capital": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+\\.[0-9]{2}$",
              "description": "Decimal serialized as a string to avoid float drift."
            },
            "simple_tax_option": {
              "type": "boolean"
            },
            "mei_option": {
              "type": "boolean"
            },
            "address": {
              "type": "object",
              "properties": {
                "street_type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "street": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "number": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "complement": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "district": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "postal_code": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{8}$"
                },
                "city_code": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "city_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "state": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Z]{2}$"
                },
                "country_code": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            },
            "contacts": {
              "type": "object",
              "properties": {
                "phones": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "area_code": {
                        "type": "string",
                        "pattern": "^[0-9]{1,3}$"
                      },
                      "number": {
                        "type": "string",
                        "pattern": "^[0-9]{7,}$"
                      }
                    },
                    "required": [
                      "area_code",
                      "number"
                    ],
                    "additionalProperties": false
                  }
                },
                "fax": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "email": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "email"
                }
              },
              "required": [
                "phones"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "cnpj",
            "headquarters_branch",
            "registration_status",
            "registration_status_code",
            "secondary_cnaes",
            "simple_tax_option",
            "mei_option",
            "address",
            "contacts"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "cnpj",
        "previous_registration_status_code",
        "current_registration_status_code",
        "company"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "subject",
    "source",
    "occurred_at",
    "correlation_id",
    "data",
    "metadata"
  ],
  "additionalProperties": false
}
