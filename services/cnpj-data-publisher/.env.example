# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=cnpj-data-publisher

# --- PostgreSQL ---
DATABASE_URL=postgresql+psycopg://cnpj:cnpj@postgres:5432/cnpj

# --- NATS JetStream ---
NATS_URL=nats://nats:4222
NATS_CREDS_FILE=
NATS_STREAM=BRAZIL_COMPANY_EVENTS
NATS_SUBJECT_PREFIX=company.br.cnpj
NATS_STREAM_REPLICAS=1
NATS_STREAM_MAX_AGE_DAYS=30
NATS_STREAM_DUPLICATE_WINDOW_HOURS=24
NATS_CONNECT_TIMEOUT_SECONDS=10

# --- Receita Federal source ---
RECEITA_BASE_URL=https://arquivos.receitafederal.gov.br/dados/cnpj/dados_abertos_cnpj
RECEITA_INCLUDE_PARTNERS=false
RECEITA_MAX_DOWNLOAD_CONCURRENCY=4
RECEITA_REQUEST_TIMEOUT_SECONDS=60
RECEITA_DOWNLOAD_RETRIES=5
RECEITA_DOWNLOAD_CHUNK_SIZE_BYTES=8388608
RECEITA_ALLOWED_HOSTS=arquivos.receitafederal.gov.br,dadosabertos.rfb.gov.br

# --- Storage ---
# STORAGE_BACKEND: LOCAL | S3 | GCS
STORAGE_BACKEND=LOCAL
STORAGE_LOCAL_PATH=/data
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# Parallel object uploads per snapshot directory (S3 and GCS)
S3_UPLOAD_CONCURRENCY=8

# --- Google Cloud Storage (STORAGE_BACKEND=GCS, native SDK) ---
# Install the extra: pip install -e '.[gcs]'
GCS_BUCKET=
GCS_PROJECT=
# Path to a service-account JSON key. Leave empty to use Application Default
# Credentials (Workload Identity on GKE, gcloud auth, metadata server).
GOOGLE_APPLICATION_CREDENTIALS=

# --- Extraction limits ---
MAX_EXTRACTED_FILE_SIZE_BYTES=50000000000
MAX_TOTAL_EXTRACTED_SIZE_BYTES=500000000000
# Archives extracted in parallel
EXTRACT_CONCURRENCY=4

# --- Processing ---
INCLUDE_BRANCHES=false
INITIAL_SNAPSHOT_MODE=STORE_ONLY
SCHEMA_VERSION=1
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4

# --- Parquet ---
PARQUET_COMPRESSION=zstd
PARQUET_ROW_GROUP_SIZE=250000

# --- Validation thresholds ---
MAX_REJECTED_ROW_PERCENTAGE=0.01
MIN_EXPECTED_TOTAL_ROWS=1000000

# --- Outbox ---
OUTBOX_BATCH_SIZE=500
OUTBOX_CONCURRENCY=20
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=3600

# --- Backfill ---
BACKFILL_DEFAULT_BATCH_SIZE=1000
BACKFILL_DEFAULT_RATE=0

# --- Retention ---
KEEP_RAW_DOWNLOADS_MONTHS=2
KEEP_EXTRACTED_FILES_MONTHS=1
KEEP_CANONICAL_SNAPSHOTS_MONTHS=3
KEEP_DIFFS_MONTHS=6
KEEP_REJECTED_ROWS_MONTHS=3
KEEP_PUBLISHED_OUTBOX_DAYS=14

# --- Observability ---
METRICS_PORT=9090
HEALTH_PORT=8080
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Email notifications (monthly job outcome) ---
# SMTP_PASSWORD must come from a secret (env/Infisical), never a plain file.
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=
# Comma-separated recipient list.
NOTIFY_EMAIL_TO=
