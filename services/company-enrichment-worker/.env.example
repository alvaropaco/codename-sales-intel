# company-enrichment-worker
# `.env.example` contains ONLY variable NAMES (never values).
# All real secrets live in Infisical and are injected at deploy time.
#
# --- NATS JetStream ---
NATS_URL=
NATS_CREDS=
NATS_FETCH_BATCH_SIZE=20
NATS_MAX_ACK_PENDING=100
NATS_CONSUMER_NAME=enrichment-worker
NATS_STREAM=ENRICHMENT

# --- PostgreSQL ---
DATABASE_URL=

# --- CNPJ warehouse (deterministic firmographics + optional QSA) ---
CNPJ_DATABASE_URL=
CNPJ_QUERY_TIMEOUT_SECONDS=5
# QSA (quadro societario) table name in cnpj-postgres. Unset = disabled
# (schema not yet confirmed); registry still surfaces people from hints.
CNPJ_QSA_TABLE=

# --- Worker ---
WORKER_CONCURRENCY=10
WORKER_HEARTBEAT_SECONDS=15
WORKER_LEASE_SECONDS=60
WORKER_ID=
SHUTDOWN_GRACE_SECONDS=60
WORKER_LEASE_TAKEOVER_STALE_SECONDS=90

# --- Multi-worker OSINT expansion ---
# Worker type(s) this pod runs. 'core' = legacy single-process pipeline
# (default, backward compatible). Examples: bbot | registry,domain,contacts |
# orchestrator | social | people | relationships | financial | spiderfoot
WORKER_TYPES=core
GRAPH_MAX_DEPTH=2
GRAPH_MAX_DIRECTIVES=50
GRAPH_MAX_FACTS=200
GRAPH_LEASE_SECONDS=60

# --- BBOT (recon engine) ---
BBOT_BIN=bbot
BBOT_TIMEOUT_SECONDS=300
BBOT_MAX_EVENTS=2000

# --- SpiderFoot (optional, disabled by default) ---
SPIDERFOOT_ENABLED=false
SPIDERFOOT_BIN=sf.py
SPIDERFOOT_TIMEOUT_SECONDS=600

# --- Crawler ---
CRAWLER_MAX_PAGES=30
CRAWLER_MAX_DEPTH=3
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_RESPONSE_BYTES=5000000

# --- JetStream stream/subjects ---
STREAM_NAME=ENRICHMENT
# Legacy mode: enrichment.company.>  |  Graph mode: widen to enrichment.>
STREAM_SUBJECTS=enrichment.company.>
# Graph mode (multi-worker) subjects; distinct from legacy company.* so graph
# workers can run additively without double-processing or clobbering completed.v1.
GRAPH_SUBJECT_REQUESTED=enrichment.company.graph.requested.v1
GRAPH_SUBJECT_COMPLETED=enrichment.company.graph.completed.v1
GRAPH_SUBJECT_PARTIAL=enrichment.company.graph.partial.v1

# --- FlareSolverr ---
FLARESOLVERR_URL=
FLARESOLVERR_MAX_CONCURRENCY=3
FLARESOLVERR_TIMEOUT_SECONDS=60

# --- SearXNG ---
SEARXNG_URL=

# --- AI Gateway ---
AI_GATEWAY_URL=http://litellm-gateway.ai-gateway.svc.cluster.local:4000
AI_GATEWAY_API_KEY=
ENRICHMENT_MODEL_PRIMARY=gpt-4.1-mini
ENRICHMENT_MODEL_FALLBACK_1=deepseek-v4-flash-0731
ENRICHMENT_MODEL_FALLBACK_2=kimi-k2.6
LLM_MAX_INPUT_CHARS=30000

# --- Object storage (optional) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Redis (distributed rate limiting) ---
REDIS_URL=

# --- Observability ---
PORT=8080
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=company-enrichment-worker
LOG_LEVEL=INFO
